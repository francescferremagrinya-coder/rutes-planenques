{
  "hosting": [
    {
      "target": "app",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "landing/**"
      ],
      "headers": [
        {
          "source": "**/*.@(png|jpg|jpeg|gif|webp|svg)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        }
      ]
    },
    {
      "target": "landing",
      "public": "landing",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(png|jpg|jpeg|gif|webp|svg)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        }
      ]
    }
  ]
}
